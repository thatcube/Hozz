{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hozz.brando.page/schema/hozz/v1/canonical-record.schema.json",
  "title": "Hozz canonical record",
  "description": "The versioned, lossless record carried in a Hozz NDJSON archive. Run-level records share the stream and are distinguished by kind.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "canonicalId": {
      "type": "string",
      "minLength": 1
    },
    "canonicalType": {
      "type": "string",
      "minLength": 1
    },
    "parentCanonicalId": {
      "type": "string",
      "minLength": 1
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string"
    },
    "deleted": {
      "type": "boolean"
    },
    "type": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date-time"
    },
    "endDate": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": "object",
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "canonical": {
          "$ref": "#/$defs/valueAndUnit"
        },
        "original": {
          "$ref": "#/$defs/sourceValue"
        }
      },
      "additionalProperties": true
    },
    "sourceRecord": {
      "type": "object",
      "required": [
        "store",
        "id",
        "type"
      ],
      "properties": {
        "store": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "store"
        ],
        "properties": {
          "store": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "recordId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "valueAndUnit": {
      "type": "object",
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceValue": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
