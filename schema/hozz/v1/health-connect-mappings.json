  "warningMessages": {
    "heart-rate-aggregate": "Health Connect needs individual heart-rate readings; this archive record is an aggregate and cannot be projected exactly.",
    "clinical-snapshot-incomplete": "Clinical records remain archive-only, and Apple extraction is not considered complete until full-scan deletions are reconciled.",
    "cumulative-source-overlap": "Overlapping cumulative records from multiple Apple sources can inflate Health Connect totals after attribution collapses to Hozz.",
    "sleep-core-to-light": "Apple's Core sleep stage is projected as Health Connect Light sleep.",
    "sleep-in-bed-overlap": "In-bed intervals stay in the Hozz archive because Health Connect sleep-stage overlap semantics differ.",
    "sleep-session-required": "Individual Apple sleep stages stay archive-only until Hozz can assemble complete non-overlapping Health Connect sleep sessions.",
    "workout-activity-generalized": "The Apple workout activity has no exact Health Connect exercise type and is projected as Other workout.",
    "workout-details-archive-only": "Workout events, statistics, route relationships, or multi-sport legs remain only in the Hozz archive.",
    "source-store-loop": "This record already came from this Health Connect package and will not be written back to it.",
    "unsupported-type": "Health Connect has no mapped representation for this record.",
    "invalid-value": "The record value is outside the range Health Connect accepts.",
    "tombstone": "Deleted records remain as Hozz tombstones and are not inserted into Health Connect."
  }
